# Backend config for the PRODUCTION environment
# (API serving https://decirclesolar.com/)
# Copy this to server/.env on the production server (do not commit the real file).

BREVO_API_KEY=your-brevo-api-key-here
CONTACT_TO_EMAIL=care@decirclesolar.com
CONTACT_FROM_EMAIL=no-reply@decirclesolar.com
CONTACT_FROM_NAME=DeCircle Solar Website

# Only the production origins may call this API.
ALLOWED_ORIGINS=https://decirclesolar.com,https://www.decirclesolar.com

# Ports 6000+ only, per hosting policy.
# Use a different port than staging if both run on the same host.
PORT=6100
