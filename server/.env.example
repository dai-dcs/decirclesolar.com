# Brevo (formerly Sendinblue) transactional email API key.
# Create one at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# The mailbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=care@decirclesolar.com

# The "from" address used to send the notification email.
# IMPORTANT: this address (or its domain) must be a verified sender in Brevo,
# otherwise Brevo will reject the send.
CONTACT_FROM_EMAIL=no-reply@decirclesolar.com
CONTACT_FROM_NAME=DeCircle Solar Website

# Comma-separated list of origins allowed to call this API. Set this per
# environment — do not list both staging and production at once unless you
# genuinely want both origins to share one backend.
#
# Local development:
#   ALLOWED_ORIGINS=http://localhost:6173
# Staging:
#   ALLOWED_ORIGINS=https://website-staging.decirclesolar.com
# Production:
#   ALLOWED_ORIGINS=https://decirclesolar.com,https://www.decirclesolar.com
ALLOWED_ORIGINS=http://localhost:6173

# Ports 6000+ only, per hosting policy.
PORT=6100
