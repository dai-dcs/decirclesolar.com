# Backend config for the STAGING environment
# (API serving https://website-staging.decirclesolar.com/)
# Copy this to server/.env on the staging server (do not commit the real file).

BREVO_API_KEY=your-brevo-api-key-here
CONTACT_TO_EMAIL=care@decirclesolar.com
CONTACT_FROM_EMAIL=no-reply@decirclesolar.com
CONTACT_FROM_NAME=DeCircle Solar Website (Staging)

# Only the staging origin may call this API.
ALLOWED_ORIGINS=https://website-staging.decirclesolar.com

# Ports 6000+ only, per hosting policy.
PORT=6100
