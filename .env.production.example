# Frontend build-time config for the PRODUCTION environment
# (https://decirclesolar.com/)
#
# Vite picks up .env.production automatically on a plain `npm run build`
# (production is Vite's default mode), or explicitly with --mode production.
#
# If the API is reverse-proxied under the same domain at /api, leave this blank
# and requests will go to a same-origin relative path.
VITE_API_BASE_URL=https://decirclesolar.com/api
