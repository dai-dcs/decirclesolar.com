# Frontend build-time config for the STAGING environment
# (https://website-staging.decirclesolar.com/)
#
# Usage: cp .env.staging.example .env.production.local  --> no, see README.
# Vite picks up .env.staging automatically when you build with --mode staging:
#   npm run build -- --mode staging
#
# If the API is reverse-proxied under the same domain at /api, leave this blank
# and requests will go to a same-origin relative path.
VITE_API_BASE_URL=https://website-staging.decirclesolar.com/api
